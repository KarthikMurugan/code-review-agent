# Copy to .env and replace only the key placeholder.
NEBIUS_API_KEY=replace_with_your_nebius_api_key
REVIEW_MODEL=nebius:moonshotai/Kimi-K2.7-Code
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Hosted webhook service: generate independent random secrets (32+ characters).
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
REVIEW_API_TOKEN=replace_with_a_different_long_random_status_token
GITHUB_APP_ID=replace_with_your_numeric_app_id
# Absolute host path; Docker mounts this file into the worker as a secret.
GITHUB_PRIVATE_KEY_FILE=/absolute/path/to/github-app.pem
